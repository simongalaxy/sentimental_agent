# logger configurations.
log_level=INFO
log_path=./logs/

# summary report configurations.
summary_report_path = ./summary_reports/

# Data Source configurations.
source_filename = amazon_google_reviews.csv
source_folderpath = ./data/original/

# Processed data.
processed_files_folderPath = ./data/Processed_files

# HuggingFace settings for ReviewsClassifier.
# 1. DuplicatesRemover:
duplicates_embedding_model = all-MiniLM-L6-v2

# 2. SentimentalClassifier.
sentimental_task = sentiment-analysis
sentimental_model = distilbert-base-uncased-finetuned-sst-2-english

# 3. TopicIdentifier.
topic_embedding_model = sentence-transformers/all-mpnet-base-v2

# ollama LLM settings for insight and report generator.
# ollama cloud settings.
cloud_model = gpt-oss:120b-cloud
cloud_host = https://ollama.com

# ollama local settings.
local_model = gemma4:12b-mlx # mistral:latest
local_host=http://localhost:11434

